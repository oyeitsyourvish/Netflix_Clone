@model NetflixClone.Models.Movie

<div class="movie-card">

    <a asp-controller="Movies"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="movie-link">

        <img src="@Model.ThumbnailUrl"
             alt="@Model.Title"
             class="movie-image" />

        <div class="movie-overlay">

            <div class="play-button">
                ▶
            </div>

        </div>

    </a>

    <div class="movie-info">

        <h5>@Model.Title</h5>

        <p>
            @Model.ReleaseYear
            <span>•</span>
            ⭐ @Model.Rating
        </p>

    </div>

</div>
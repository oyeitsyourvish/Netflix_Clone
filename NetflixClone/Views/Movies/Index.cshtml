@model IEnumerable<NetflixClone.Models.Movie>

<h1>Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Movie
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Year</th>
            <th>Duration</th>
            <th>Rating</th>
            <th>Featured</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.ReleaseYear</td>
                <td>@movie.Duration minutes</td>
                <td>@movie.Rating</td>
                <td>@movie.IsFeatured</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@movie.Id">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@movie.Id">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@movie.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
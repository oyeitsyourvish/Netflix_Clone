@model NetflixClone.Models.Movie

<div class="movie-details">

    <!-- Hero Banner -->
    <div class="movie-details-hero"
         style="background-image:
        linear-gradient(
        to right,
        rgba(0,0,0,0.95),
        rgba(0,0,0,0.45),
        rgba(0,0,0,0.2)
        ),
        url('@Model.BannerUrl');">

        <div class="movie-details-content">

            <!-- Movie Title -->
            <h1>
                @Model.Title
            </h1>

            <!-- Movie Metadata -->
            <div class="movie-meta">

                <span>
                    @Model.ReleaseYear
                </span>

                <span>•</span>

                <span>
                    @Model.Duration min
                </span>

                <span>•</span>

                <span>
                    ⭐ @Model.Rating
                </span>

            </div>

            <!-- Categories -->
            <div class="movie-categories">

                @foreach (var movieCategory in Model.MovieCategories)
                {
                    <span class="movie-category">
                        @movieCategory.Category.Name
                    </span>
                }

            </div>

            <!-- Description -->
            <p class="movie-description">
                @Model.Description
            </p>

            <!-- Buttons -->
            <div class="movie-actions">

                <!-- Watch Now -->
                <a asp-controller="Movies"
                   asp-action="Watch"
                   asp-route-id="@Model.Id"
                   class="btn btn-netflix">

                    ▶ Watch Now

                </a>


                <!-- My List -->
                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
                {
                    @if (ViewBag.IsInMyList == true)
                    {
                        <!-- Remove from My List -->

                        <form asp-controller="MyList"
                              asp-action="Remove"
                              method="post">

                            <input type="hidden"
                                   name="movieId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-netflix-secondary">

                                ✓ In My List

                            </button>

                        </form>
                    }
                    else
                    {
                        <!-- Add to My List -->

                        <form asp-controller="MyList"
                              asp-action="Add"
                              method="post">

                            <input type="hidden"
                                   name="movieId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-netflix-secondary">

                                + My List

                            </button>

                        </form>
                    }
                }
                else
                {
                    <!-- Login Required -->

                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Context.Request.Path"
                       class="btn btn-netflix-secondary">

                        + My List

                    </a>
                }

            </div>

        </div>

    </div>

</div>
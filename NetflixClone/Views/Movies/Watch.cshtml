@model NetflixClone.Models.Movie

<div class="watch-page">

    <div class="watch-header">

        <a asp-controller="Movies"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="watch-back">
            ← Back
        </a>

        <h2>@Model.Title</h2>

    </div>

    <div class="video-container">

        <video controls
               preload="metadata"
               playsinline
               class="movie-player">

            <source src="@Model.VideoUrl"
                    type="video/mp4" />

            Your browser does not support HTML5 video.

        </video>

    </div>

</div>
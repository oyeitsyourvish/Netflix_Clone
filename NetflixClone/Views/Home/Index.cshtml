@model NetflixClone.ViewModels.HomeViewModel

@if (Model.FeaturedMovie != null)
{
    <section class="hero"
             style="background-image:
        linear-gradient(to right, #000 0%, transparent 70%),
        url('@Model.FeaturedMovie.BannerUrl');">

        <div class="hero-content">

            <h1>
                @Model.FeaturedMovie.Title
            </h1>

            <p>
                @Model.FeaturedMovie.Description
            </p>

            <p>
                <strong>
                    @Model.FeaturedMovie.ReleaseYear
                </strong>

                &nbsp; • &nbsp;

                ⭐ @Model.FeaturedMovie.Rating

                &nbsp; • &nbsp;

                @Model.FeaturedMovie.Duration min
            </p>

            <div>

                <a asp-controller="Movies"
                   asp-action="Details"
                   asp-route-id="@Model.FeaturedMovie.Id"
                   class="btn btn-netflix">

                    ▶ Play

                </a>

                <button class="btn btn-netflix-secondary">
                    + My List
                </button>

            </div>

        </div>

    </section>
}


<div class="container-fluid px-4">

    <!-- TRENDING -->

    <section class="movie-section">

        <h2>Trending Now</h2>

        <div class="movie-row">

            @foreach (var movie in Model.TrendingMovies)
            {
                <partial name="_MovieCard"
                         model="movie" />
            }

        </div>

    </section>


    <!-- CATEGORIES -->
    @foreach (var category in Model.Categories)
    {
        <section class="movie-section">

            <h2>
                @category.CategoryName
            </h2>

            <div class="movie-row">

                @foreach (var movie in category.Movies)
                {
                    <partial name="_MovieCard"
                             model="movie" />
                }

            </div>

        </section>
    }

</div>